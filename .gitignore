# Secrets - never commit
.env
Scripts/.env

# Local working notes for handing off between chat sessions -- states
# business intent (monetization plans) that deliberately shouldn't sit in
# a public repo. Enforced here rather than left to memory alone, since
# whatever picks this up next might not know that.
HANDOVER.md

# Runtime-generated pipeline output (regenerated on each run)
Data/Output/
Data/Temporary/
Data/Results/

# Python
__pycache__/
*.pyc

# Backend runtime state (seeded copies of Data/Input + per-job files,
# regenerated as needed -- see backend/run_job.py)
backend/workdir/

# Future backend/frontend build artifacts
backend/.venv/
backend/__pycache__/
frontend/node_modules/
frontend/dist/

# OS junk
.DS_Store
Thumbs.db
