# Secrets - never commit
.env
Scripts/.env

# Runtime-generated pipeline output (regenerated on each run)
Data/Output/
Data/Temporary/
Data/Results/

# Python
__pycache__/
*.pyc

# Backend runtime state (seeded copies of Data/Input + per-job files,
# regenerated as needed -- see backend/run_job.py)
backend/workdir/

# Future backend/frontend build artifacts
backend/.venv/
backend/__pycache__/
frontend/node_modules/
frontend/dist/

# OS junk
.DS_Store
Thumbs.db
